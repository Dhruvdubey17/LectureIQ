# LLM provider: ollama (default, local, free), groq, or openai.
LECTUREIQ_LLM=ollama
OLLAMA_MODEL=llama3.2:3b

# To use Groq: set LECTUREIQ_LLM=groq, pip install -e ".[groq]", and set the key.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# To use OpenAI: set LECTUREIQ_LLM=openai, pip install -e ".[openai]", and set the key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Whisper model size for the audio path: tiny, base, small, medium.
WHISPER_MODEL=base
